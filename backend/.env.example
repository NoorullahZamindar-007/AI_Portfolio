# Copy to .env and fill in your own values. Never commit a real .env.
# Groq API key. When unset, the server uses the local keyword router
# in main.py instead of the LLM.
GROQ_API_KEY=
# Comma-separated list of allowed frontend origins for CORS.
# When unset, all origins are allowed (without credentials).
FRONTEND_URL=http://localhost:5173
